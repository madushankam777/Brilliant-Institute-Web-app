PORT=5001
# development | production | test
NODE_ENV=development

# --- Frontend origin (used for CORS + cookie settings) ---
# Must be the EXACT origin of the React app. Never use "*" when credentials
# (cookies) are involved, per OWASP CORS guidance.
CLIENT_ORIGIN=http://localhost:5174

# --- MySQL Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brilliant_institute
DB_USER=brilliant_institute
DB_PASSWORD=change-me-strong-password
DB_CONNECTION_LIMIT=10

# --- Authentication / JWT ---

JWT_SECRET=
# Access token lifetime (JWT). Kept short because it is stored in a
JWT_EXPIRES_IN=30m
# Idle session timeout in minutes - cookie itself expires after this too.
SESSION_TIMEOUT_MINUTES=30

# --- Password Hashing ---
BCRYPT_SALT_ROUNDS=12

# --- Rate Limiting (OWASP: brute-force / credential-stuffing protection) ---
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX_REQUESTS=1500

# --- Account Lockout (brute force mitigation) ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Business Rules (configurable, not hardcoded - see SRS Appendix C) ---
LOW_ATTENDANCE_THRESHOLD_PERCENT=80

# --- Payment Gateway (third-party, PCI-compliant) ---
PAYMENT_GATEWAY_PROVIDER_NAME=mock-gateway
PAYMENT_GATEWAY_API_KEY=

# --- Tutor Payouts (sending money OUT to tutors) ---
# PayHere only COLLECTS money - it cannot pay a tutor. Choose how payouts go:
#
#   BANK_FILE (default) - each payout is queued with the tutor's account, and
#     exported as a bulk-credit CSV you upload to your bank's corporate online
#     banking. The bank moves the money; you mark the batch settled here.
#   API - a payout provider you hold an account with (requires their KYC and
#     credentials). Payouts are sent straight through and come back SENT/FAILED.
PAYOUT_PROVIDER=BANK_FILE
PAYOUT_PROVIDER_NAME=
PAYOUT_API_BASE_URL=
PAYOUT_API_KEY=
PAYOUT_CURRENCY=LKR

# --- Email (password reset codes) ---
# Leave SMTP_HOST empty in development to use a free Ethereal test inbox
# (the server log prints a link to each email). For real email with Gmail:
# turn on 2-Step Verification, create an App Password, then set
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<16-letter app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
