# =============================================================================
# Brilliant Institute API - Environment Variables (EXAMPLE FILE)
# =============================================================================
# Copy this file to ".env" and fill in real values for your machine.
# NEVER commit the real ".env" file - it is already excluded in .gitignore.
# NEVER hardcode secrets (passwords, JWT keys, API keys) directly in source code.
# =============================================================================

# --- Server ---
# Port the Express API listens on
PORT=5000
# development | production | test
NODE_ENV=development

# --- Frontend origin (used for CORS + cookie settings) ---
# Must be the EXACT origin of the React app. Never use "*" when credentials
# (cookies) are involved, per OWASP CORS guidance.
CLIENT_ORIGIN=http://localhost:5173

# --- MySQL Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brilliant_institute
DB_USER=brilliant_institute
DB_PASSWORD=change-me-strong-password
DB_CONNECTION_LIMIT=10

# --- Authentication / JWT ---
# Generate a long random secret, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Do NOT reuse this example value - it is intentionally left blank.
JWT_SECRET=
# Access token lifetime (JWT). Kept short because it is stored in a
# short-lived httpOnly cookie (see REG-06: automatic session timeout).
JWT_EXPIRES_IN=30m
# Idle session timeout in minutes - cookie itself expires after this too.
SESSION_TIMEOUT_MINUTES=30

# --- Password Hashing ---
# bcrypt salt rounds - 12 is a strong, widely recommended default (2024).
BCRYPT_SALT_ROUNDS=12

# --- Rate Limiting (OWASP: brute-force / credential-stuffing protection) ---
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX_REQUESTS=300

# --- Account Lockout (brute force mitigation) ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Business Rules (configurable, not hardcoded - see SRS Appendix C) ---
LOW_ATTENDANCE_THRESHOLD_PERCENT=80

# --- Payment Gateway (built-in simulator) ---
# Used only when PayHere below is NOT configured, so the project still runs
# end-to-end on a laptop with no merchant account. No real money moves.
PAYMENT_GATEWAY_PROVIDER_NAME=mock-gateway
PAYMENT_GATEWAY_API_KEY=

# =============================================================================
# --- PayHere (REAL card / eZ Cash / mCash payments) ---
# =============================================================================
# Leave PAYHERE_MERCHANT_ID blank to keep using the simulator above.
#
# Setup, once:
#   1. Create an account at https://www.payhere.lk (sandbox: https://sandbox.payhere.lk)
#   2. Dashboard -> Settings -> Domains & Credentials: add your domain and
#      generate a Merchant Secret for it. The secret is tied to the domain,
#      so sandbox and live each need their own.
#   3. Dashboard -> Settings -> Withdrawal/Bank: this is where you set the
#      bank account PayHere settles money into. The app never sees it -
#      card money always lands in your PayHere account first, then PayHere
#      pays out to that bank account on their settlement schedule.
#
# This project never receives, stores, or logs a card number: the payer types
# their card on PayHere's own page, which keeps you out of PCI-DSS SAQ-D.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# sandbox | live  - keep "sandbox" until PayHere approves your live account.
PAYHERE_MODE=sandbox
PAYHERE_CURRENCY=LKR

# The PUBLIC https:// origin this app is reachable on. PayHere sends the payer
# back here, and POSTs the payment notification to:
#     <PUBLIC_BASE_URL>/api/payments/payhere/notify
# It MUST be reachable from the internet - "localhost" will never receive a
# notification. While developing, run a tunnel and paste its URL here, e.g.
#     cloudflared tunnel --url http://localhost:5173
#     ngrok http 5173
PUBLIC_BASE_URL=
# Only needed if your API is on a different public origin than the site
# (leave blank when Vite proxies /api, which is the default here).
PAYHERE_NOTIFY_URL=

# --- Tutor Payouts (sending money OUT to tutors) ---
# PayHere only COLLECTS money - it cannot pay a tutor. Choose how payouts go:
#
#   BANK_FILE (default) - each payout is queued with the tutor's account, and
#     exported as a bulk-credit CSV you upload to your bank's corporate online
#     banking. The bank moves the money; you mark the batch settled here.
#   API - a payout provider you hold an account with (requires their KYC and
#     credentials). Payouts are sent straight through and come back SENT/FAILED.
PAYOUT_PROVIDER=BANK_FILE
PAYOUT_PROVIDER_NAME=
PAYOUT_API_BASE_URL=
PAYOUT_API_KEY=
PAYOUT_CURRENCY=LKR
