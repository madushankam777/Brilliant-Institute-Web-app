# =============================================================================
# Brilliant Institute API - Environment Variables (EXAMPLE FILE)
# =============================================================================
# Copy this file to ".env" and fill in real values for your machine.
# NEVER commit the real ".env" file - it is already excluded in .gitignore.
# NEVER hardcode secrets (passwords, JWT keys, API keys) directly in source code.
# =============================================================================

# --- Server ---
# Port the Express API listens on
PORT=5000
# development | production | test
NODE_ENV=development

# --- Frontend origin (used for CORS + cookie settings) ---
# Must be the EXACT origin of the React app. Never use "*" when credentials
# (cookies) are involved, per OWASP CORS guidance.
CLIENT_ORIGIN=http://localhost:5173

# --- MySQL Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brilliant_institute
DB_USER=brilliant_institute
DB_PASSWORD=change-me-strong-password
DB_CONNECTION_LIMIT=10

# --- Authentication / JWT ---
# Generate a long random secret, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Do NOT reuse this example value - it is intentionally left blank.
JWT_SECRET=
# Access token lifetime (JWT). Kept short because it is stored in a
# short-lived httpOnly cookie (see REG-06: automatic session timeout).
JWT_EXPIRES_IN=30m
# Idle session timeout in minutes - cookie itself expires after this too.
SESSION_TIMEOUT_MINUTES=30

# --- Password Hashing ---
# bcrypt salt rounds - 12 is a strong, widely recommended default (2024).
BCRYPT_SALT_ROUNDS=12

# --- Rate Limiting (OWASP: brute-force / credential-stuffing protection) ---
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX_REQUESTS=300

# --- Account Lockout (brute force mitigation) ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Business Rules (configurable, not hardcoded - see SRS Appendix C) ---
LOW_ATTENDANCE_THRESHOLD_PERCENT=80

# Public holidays on the calendars come from this Google Calendar's free public
# feed (no API key needed). Leave commented out to use Sri Lanka's holidays.
# HOLIDAY_CALENDAR_ID="en.lk#holiday@group.v.calendar.google.com"

# --- Payment Gateway (third-party, PCI-compliant) ---
# This project never stores card data. These values would be supplied by
# the real gateway provider once selected (see SRS Appendix C - TBD list).
PAYMENT_GATEWAY_PROVIDER_NAME=mock-gateway
PAYMENT_GATEWAY_API_KEY=

# Set to true when the app sits behind a reverse proxy / tunnel that runs on
# this machine (Vite's proxy, cloudflared) so rate limits see the real client
# IP and HTTPS requests get a Secure session cookie. "true" trusts loopback
# proxies only; a hop count (1) or address list is also accepted.
TRUST_PROXY=false
# Force the Secure flag on the session cookie regardless of the above.
COOKIE_SECURE=false

# --- Tutor Payouts (sending money OUT to tutors) ---
# PayHere only COLLECTS money - it cannot pay a tutor. Admin pays from the
# institute's bank (online banking) and records the bank's reference number.
# Extra options once sql/update_database.sql has been run:
#   BANK_FILE (default) - payouts can also be queued and downloaded as one
#     bulk-credit CSV for corporate online banking.
#   API - send payouts through a payout provider you hold an account with
#     (needs their KYC and credentials).
PAYOUT_PROVIDER=BANK_FILE
PAYOUT_PROVIDER_NAME=
PAYOUT_API_BASE_URL=
PAYOUT_API_KEY=
PAYOUT_CURRENCY=LKR
