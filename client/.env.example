# =============================================================================
# Brilliant Institute Client - Environment Variables (EXAMPLE FILE)
# =============================================================================
# Copy this file to ".env" (Vite also supports ".env.local") and adjust
# if your API runs somewhere other than localhost:5000.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle -
# never put secrets here, since anything in this file ends up visible in
# the compiled frontend JavaScript that ships to every visitor's browser.
# =============================================================================

VITE_API_BASE_URL=http://localhost:5000/api
